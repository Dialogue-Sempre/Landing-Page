---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	robots?: string;
}

const { title, description, canonicalPath, robots } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={title} description={description} canonicalPath={canonicalPath} robots={robots} />
	</head>
	<body class="min-h-screen bg-brand-white font-sans text-brand-ink antialiased">
		<slot />
		<script src="/scripts/content-runtime.js" defer></script>
	</body>
</html>
