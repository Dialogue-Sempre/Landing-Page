---
import site from '../data/site.json';
import CmsText from './CmsText.astro';

interface Props {
	editable?: boolean;
}

const { editable = false } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-brand-blue/10 bg-brand-white/95 backdrop-blur-md">
	<nav
		class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6"
		aria-label={site.navAriaLabel}
	>
		<a href="/" class="text-lg font-bold tracking-tight text-brand-blue" aria-label={site.logoAriaLabel}>
			<CmsText file="site" path="logoPrimary" editable={editable} class="inline">{site.logoPrimary}</CmsText>
			{' '}
			<CmsText file="site" path="logoAccent" editable={editable} class="inline font-semibold text-brand-gold">
				{site.logoAccent}
			</CmsText>
		</a>

		<ul class="hidden items-center gap-2 md:flex">
			{
				site.nav.map((item, index) => (
					<li>
						<a
							href={editable ? '#': item.href}
							class="rounded-full px-4 py-2 text-sm font-medium text-brand-blue transition-colors hover:bg-brand-blue-light/20 hover:text-brand-blue"
						>
							<CmsText file="site" path={`nav.${index}.label`} editable={editable}>
								{item.label}
							</CmsText>
						</a>
					</li>
				))
			}
		</ul>

		<p class="flex items-center gap-2 sm:gap-3">
			<a
				href={editable ? '#' : site.loginUrl}
				class="hidden rounded-full px-3 py-2 text-sm font-semibold text-brand-blue transition-colors hover:bg-brand-blue-light/15 sm:inline-flex"
			>
				<CmsText file="site" path="header.loginLabel" editable={editable}>{site.header.loginLabel}</CmsText>
			</a>
			<a
				href={editable ? '#' : site.cadastroUrl}
				class="inline-flex items-center justify-center rounded-full bg-brand-gold px-4 py-2 text-sm font-semibold text-brand-ink shadow-sm transition-all duration-300 hover:brightness-105 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
				aria-label={site.header.ctaAriaLabel}
			>
				<CmsText file="site" path="header.ctaLabel" editable={editable}>{site.header.ctaLabel}</CmsText>
			</a>
		</p>
	</nav>
</header>
