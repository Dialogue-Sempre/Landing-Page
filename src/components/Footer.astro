---
import site from '../data/site.json';
import CmsText from './CmsText.astro';

interface Props {
	editable?: boolean;
}

const { editable = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-blue/30 bg-brand-blue px-4 py-12 text-brand-white/85 sm:px-6">
	<section class="mx-auto flex max-w-6xl flex-col gap-8 md:flex-row md:items-start md:justify-between">
		<article>
			<p class="text-lg font-bold text-brand-white">
				<CmsText file="site" path="logoPrimary" editable={editable} class="inline">{site.logoPrimary}</CmsText>
				{' '}
				<CmsText file="site" path="logoAccent" editable={editable} class="inline text-brand-gold">
					{site.logoAccent}
				</CmsText>
			</p>
			<p class="mt-2 max-w-sm text-sm text-brand-white/75">
				<CmsText file="site" path="footer.tagline" editable={editable}>{site.footer.tagline}</CmsText>
			</p>
			<p class="mt-4 text-sm text-brand-white/60">
				<CmsText file="site" path="cnpjLabel" editable={editable} class="inline">{site.cnpjLabel}</CmsText>
				{' '}
				<CmsText file="site" path="cnpj" editable={editable} class="inline">{site.cnpj}</CmsText>
			</p>
		</article>

		<nav aria-label={site.footer.navAriaLabel}>
			<ul class="flex flex-col gap-2 text-sm">
				{
					site.footer.links.map((link, index) => (
						<li>
							<a href={editable ? '#' : link.href} class="transition-colors hover:text-brand-gold">
								<CmsText file="site" path={`footer.links.${index}.label`} editable={editable}>
									{link.label}
								</CmsText>
							</a>
						</li>
					))
				}
				<li>
					<a href={editable ? '#' : `mailto:${site.email}`} class="transition-colors hover:text-brand-green">
						<CmsText file="site" path="email" editable={editable}>{site.email}</CmsText>
					</a>
				</li>
			</ul>
		</nav>
	</section>

	<p class="mx-auto mt-10 max-w-6xl border-t border-brand-white/15 pt-6 text-sm text-brand-white/55">
		© {year}{' '}
		<CmsText file="site" path="legalName" editable={editable} class="inline">{site.legalName}</CmsText>.{' '}
		<CmsText file="site" path="footer.copyrightSuffix" editable={editable} class="inline">
			{site.footer.copyrightSuffix}
		</CmsText>
	</p>
</footer>
