---
import contact from '../data/contact.json';
import CmsText from './CmsText.astro';

interface Props {
	editable?: boolean;
}

const { editable = false } = Astro.props;
---

<section
	id="contato"
	class="bg-brand-white px-4 py-20 sm:px-6 lg:py-24"
	aria-labelledby="contato-heading"
>
	<header class="mx-auto mb-10 max-w-xl text-center animate-fade-up animate-duration-700">
		<h2 id="contato-heading" class="text-3xl font-bold tracking-tight text-brand-blue sm:text-4xl">
			<CmsText file="contact" path="title" editable={editable}>{contact.title}</CmsText>
		</h2>
		<p class="mt-3 text-lg text-brand-blue-light">
			<CmsText file="contact" path="subtitle" editable={editable}>{contact.subtitle}</CmsText>
		</p>
	</header>

	<form
		action="#contato"
		method="get"
		class="mx-auto grid max-w-xl gap-5 rounded-2xl border border-brand-green/25 bg-brand-green-soft p-8 shadow-sm"
		aria-label={contact.formAriaLabel}
	>
		{
			contact.fields.map((field, index) => (
				<p>
					<label for={field.id} class="mb-1.5 block text-sm font-medium text-brand-blue">
						<CmsText file="contact" path={`fields.${index}.label`} editable={editable}>
							{field.label}
						</CmsText>
					</label>
					{editable ? (
						<p class="mb-2 text-xs text-brand-blue-light">
							Placeholder:{' '}
							<CmsText file="contact" path={`fields.${index}.placeholder`} editable={true}>
								{field.placeholder}
							</CmsText>
						</p>
					) : null}
					<input
						type={field.type}
						id={field.id}
						name={field.name}
						required={field.required && !editable}
						autocomplete={field.autocomplete}
						disabled={editable}
						class="w-full rounded-lg border border-brand-blue/20 bg-brand-white px-3 py-2.5 text-brand-ink shadow-sm outline-none transition focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 disabled:opacity-70"
						placeholder={field.placeholder}
						data-content-file="contact"
						data-content-path={`fields.${index}.placeholder`}
						data-cms-attr="placeholder"
					/>
				</p>
			))
		}
		<button
			type={editable ? 'button' : 'submit'}
			class="mt-2 inline-flex w-full items-center justify-center rounded-full bg-brand-gold px-4 py-3 text-sm font-semibold text-brand-ink transition-all duration-300 hover:brightness-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
		>
			<CmsText file="contact" path="submitLabel" editable={editable}>{contact.submitLabel}</CmsText>
		</button>
	</form>
</section>
