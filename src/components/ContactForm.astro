---
---

<section
	id="contato"
	class="bg-brand-white px-4 py-20 sm:px-6 lg:py-24"
	aria-labelledby="contato-heading"
>
	<header class="mx-auto mb-10 max-w-xl text-center animate-fade-up animate-duration-700">
		<h2 id="contato-heading" class="text-3xl font-bold tracking-tight text-brand-blue sm:text-4xl">
			Fale com a Dialogue Sempre
		</h2>
		<p class="mt-3 text-lg text-brand-blue-light">
			Deixe seus dados e nossa equipe retorna com análise e próximos passos.
		</p>
	</header>

	<form
		action="#contato"
		method="get"
		class="mx-auto grid max-w-xl gap-5 rounded-2xl border border-brand-green/25 bg-brand-green-soft p-8 shadow-sm"
		aria-label="Formulário de captação"
	>
		<p>
			<label for="nome" class="mb-1.5 block text-sm font-medium text-brand-blue">Nome</label>
			<input
				type="text"
				id="nome"
				name="nome"
				required
				autocomplete="name"
				class="w-full rounded-lg border border-brand-blue/20 bg-brand-white px-3 py-2.5 text-brand-ink shadow-sm outline-none transition focus:border-brand-green focus:ring-2 focus:ring-brand-green/20"
				placeholder="Seu nome completo"
			/>
		</p>
		<p>
			<label for="email" class="mb-1.5 block text-sm font-medium text-brand-blue">E-mail</label>
			<input
				type="email"
				id="email"
				name="email"
				required
				autocomplete="email"
				class="w-full rounded-lg border border-brand-blue/20 bg-brand-white px-3 py-2.5 text-brand-ink shadow-sm outline-none transition focus:border-brand-green focus:ring-2 focus:ring-brand-green/20"
				placeholder="voce@empresa.com.br"
			/>
		</p>
		<p>
			<label for="empresa" class="mb-1.5 block text-sm font-medium text-brand-blue">Empresa</label>
			<input
				type="text"
				id="empresa"
				name="empresa"
				required
				autocomplete="organization"
				class="w-full rounded-lg border border-brand-blue/20 bg-brand-white px-3 py-2.5 text-brand-ink shadow-sm outline-none transition focus:border-brand-green focus:ring-2 focus:ring-brand-green/20"
				placeholder="Razão social ou nome fantasia"
			/>
		</p>
		<button
			type="submit"
			class="mt-2 inline-flex w-full items-center justify-center rounded-full bg-brand-gold px-4 py-3 text-sm font-semibold text-brand-ink transition-all duration-300 hover:brightness-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
		>
			Enviar contato
		</button>
	</form>
</section>
