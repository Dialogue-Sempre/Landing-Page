---
import { AlertTriangle, CheckCircle2 } from 'lucide-astro';
import painPoints from '../data/painPoints.json';
import CmsText from './CmsText.astro';

interface Props {
	editable?: boolean;
}

const { editable = false } = Astro.props;
---

<section
	id="dores"
	class="relative overflow-hidden bg-brand-surface px-4 py-20 sm:px-6 lg:py-24"
	aria-labelledby="dores-heading"
>
	<span
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,_rgba(31,157,108,0.12),_transparent_50%),radial-gradient(ellipse_at_top_left,_rgba(242,208,73,0.1),_transparent_45%)]"
		aria-hidden="true"
	></span>

	<header class="relative mx-auto mb-12 max-w-6xl animate-fade-up animate-duration-700">
		<h2 id="dores-heading" class="text-3xl font-bold tracking-tight text-brand-blue sm:text-4xl">
			<CmsText file="painPoints" path="title" editable={editable}>{painPoints.title}</CmsText>
		</h2>
		<p class="mt-3 max-w-2xl text-lg text-brand-blue-light">
			<CmsText file="painPoints" path="subtitle" editable={editable}>{painPoints.subtitle}</CmsText>
		</p>
	</header>

	<section class="relative mx-auto grid max-w-6xl gap-8 md:grid-cols-2" aria-label={painPoints.compareAriaLabel}>
		<article class="rounded-2xl border border-brand-alert/25 bg-brand-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-alert/40 hover:shadow-xl">
			<p class="mb-4 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-alert">
				<AlertTriangle class="h-5 w-5 shrink-0" aria-hidden="true" />
				<CmsText file="painPoints" path="pain.badge" editable={editable}>{painPoints.pain.badge}</CmsText>
			</p>
			<h3 class="text-xl font-semibold text-brand-blue">
				<CmsText file="painPoints" path="pain.title" editable={editable}>{painPoints.pain.title}</CmsText>
			</h3>
			<ul class="mt-4 space-y-3 text-brand-ink/80">
				{
					painPoints.pain.items.map((item, index) => (
						<li>
							<CmsText file="painPoints" path={`pain.items.${index}`} editable={editable}>
								{item}
							</CmsText>
						</li>
					))
				}
			</ul>
		</article>

		<article class="rounded-2xl border-2 border-brand-green bg-brand-green-soft p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
			<p class="mb-4 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-green">
				<CheckCircle2 class="h-5 w-5 shrink-0" aria-hidden="true" />
				<CmsText file="painPoints" path="solution.badge" editable={editable}>{painPoints.solution.badge}</CmsText>
			</p>
			<h3 class="text-xl font-semibold text-brand-blue">
				<CmsText file="painPoints" path="solution.title" editable={editable}>{painPoints.solution.title}</CmsText>
			</h3>
			<ul class="mt-4 space-y-3 text-brand-ink/80">
				{
					painPoints.solution.items.map((item, index) => (
						<li>
							<CmsText file="painPoints" path={`solution.items.${index}`} editable={editable}>
								{item}
							</CmsText>
						</li>
					))
				}
			</ul>
		</article>
	</section>
</section>
